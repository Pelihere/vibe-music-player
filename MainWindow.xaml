<Window x:Class="PortablePlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:PortablePlayer"
        Title="Vibe" Width="1180" Height="760" MinWidth="900" MinHeight="580"
        Icon="app.ico" WindowStartupLocation="CenterScreen" AllowDrop="True" WindowStyle="None"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themed.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="48"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Rectangle Grid.RowSpan="3" Fill="{DynamicResource Texture}" IsHitTestVisible="False"/>

    <!-- ================= title bar (follows the Main Window theme) ================= -->
    <Border Grid.Row="0" Background="{DynamicResource TitleBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="224"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="4" Fill="{DynamicResource Texture}" IsHitTestVisible="False"/>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Image Source="app.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="VIBE" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                     VerticalAlignment="Center" TextOptions.TextRenderingMode="Auto">
            <TextBlock.LayoutTransform><ScaleTransform ScaleX="1.0"/></TextBlock.LayoutTransform>
          </TextBlock>
        </StackPanel>

        <Grid Grid.Column="1" Width="400" HorizontalAlignment="Center" Height="32" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <TextBox x:Name="Search" Style="{StaticResource SearchBoxStyle}" VerticalContentAlignment="Center"
                   ToolTip="Search songs, artists, albums and playlists"/>
          <TextBlock x:Name="SearchHint" Text="Search songs, artists, albums, playlists" Margin="38,0,0,0" FontSize="13"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <Button x:Name="BtnClearSearch" Style="{StaticResource TIcon}" Content="&#xE711;" Width="26" Height="26" FontSize="10"
                  HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="Clear (Esc)"/>
        </Grid>

        <Button x:Name="BtnTheme" Grid.Column="2" Style="{StaticResource TIcon}" Content="&#xE790;" Width="40" Height="34" FontSize="15"
                Margin="0,0,10,0" ToolTip="Theme" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" Content="&#xE921;" ToolTip="Minimize"/>
          <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" Content="&#xE922;" ToolTip="Maximize"/>
          <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" Content="&#xE8BB;" ToolTip="Close to tray"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= body ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="224"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
        <Grid>
          <Rectangle Fill="{DynamicResource Texture}" IsHitTestVisible="False"/>
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,12">
              <TextBlock x:Name="ScanText" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="12,0,12,8" TextWrapping="Wrap"/>
              <Button x:Name="BtnAddFolder" Style="{StaticResource TText}" Content="＋   Add music folder"/>
              <Button x:Name="BtnRescan" Style="{StaticResource TText}" Content="⟳   Rescan library"/>
            </StackPanel>
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="0,16,0,0"
                     ItemContainerStyle="{StaticResource NavItemStyle}" FontSize="13.5">
              <ListBoxItem x:Name="NavGramophone" Tag="Gramophone">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Gramophone"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="NavLibrary" Tag="Library">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Library"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Favorites">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB51;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Favorites"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Artists">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Artists"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Albums">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE93C;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Albums"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Genres">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Genres"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Playlists">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE90B;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Playlists"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="NavQueue" Tag="Queue" AllowDrop="True" ToolTip="Drop songs here to add them to the queue">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Up Next"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="NavLyrics" Tag="Lyrics">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Lyrics"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem Tag="Statistics">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Statistics"/></StackPanel>
              </ListBoxItem>
              <ListBoxItem x:Name="NavSettings" Tag="Settings">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/><TextBlock Text="Settings"/></StackPanel>
              </ListBoxItem>
            </ListBox>
          </DockPanel>
        </Grid>
      </Border>

      <!-- pages -->
      <Grid x:Name="PageHost" Grid.Column="1" ClipToBounds="True">

        <!-- Gramophone: fixed identity, never themed -->
        <Border x:Name="PageGramophone" Margin="20,16,20,20" CornerRadius="22" BorderThickness="1" BorderBrush="#3A2B1F" Visibility="Collapsed">
          <Border.Background>
            <RadialGradientBrush Center="0.3,0.4" RadiusX="1.0" RadiusY="1.0">
              <GradientStop Color="#3A281C" Offset="0"/>
              <GradientStop Color="#150E0A" Offset="1"/>
            </RadialGradientBrush>
          </Border.Background>
          <Grid Margin="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <local:GramophoneView x:Name="Gramo"/>
            <Viewbox Grid.Column="1" Margin="28,0,4,0" MaxWidth="460" StretchDirection="Both" VerticalAlignment="Center">
              <local:PlayerDeck x:Name="Deck" Width="300"/>
            </Viewbox>
          </Grid>
        </Border>

        <!-- library / favorites / artists / albums / genres / playlists -->
        <Grid x:Name="PageLibrary">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Grid Margin="30,24,30,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ViewTitle" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ViewSub" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,3,0,0"/>
            </StackPanel>
            <Button x:Name="BtnPlayAll" Grid.Column="1" Style="{StaticResource TPrimary}" Content="▶   Play" Margin="0,0,8,0"/>
            <Button x:Name="BtnShuffleAll" Grid.Column="2" Style="{StaticResource TGhost}" Content="⤮   Shuffle" Margin="0,0,8,0"/>
            <Button x:Name="BtnSort" Grid.Column="3" Style="{StaticResource TGhost}" Content="⇅   Sort By"/>
          </Grid>

          <Grid Grid.Row="1" Margin="18,0,14,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="GroupCol" Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel x:Name="GroupPane" Width="250" Margin="0,0,10,0" Visibility="Collapsed">
              <StackPanel x:Name="PlBar" DockPanel.Dock="Top" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,6">
                <Button x:Name="BtnNewPl" Style="{StaticResource TGhost}" Content="＋  New playlist" Height="32" Margin="0,0,6,0"/>
                <Button x:Name="BtnDelPl" Style="{StaticResource TText}" Content="Delete" Height="32"/>
              </StackPanel>
              <ListBox x:Name="Groups" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GroupRow}"
                       ItemContainerStyle="{StaticResource GroupItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>

            <ListBox x:Name="SongList" Grid.Column="1" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                     ItemTemplate="{StaticResource SongRow}" ItemContainerStyle="{StaticResource SongRowStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel" Foreground="{DynamicResource Fg}">
              <ListBox.ContextMenu><ContextMenu x:Name="RowMenu"/></ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="EmptyPanel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <TextBlock x:Name="EmptyText" FontSize="15" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"/>
              <Button x:Name="BtnEmptyAdd" Style="{StaticResource TPrimary}" Content="＋   Add music folder" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- search results -->
        <ScrollViewer x:Name="PageSearch" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="30,24,30,20">
            <TextBlock x:Name="SearchTitle" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="SearchSub" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,3,0,10"/>

            <StackPanel x:Name="SecSongs">
              <TextBlock Text="SONGS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,12,0,6"/>
              <ListBox x:Name="SrSongs" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                       ItemTemplate="{StaticResource SongRow}" ItemContainerStyle="{StaticResource SongRowStyle}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>
            <StackPanel x:Name="SecArtists">
              <TextBlock Text="ARTISTS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,16,0,6"/>
              <ListBox x:Name="SrArtists" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GroupRow}"
                       ItemContainerStyle="{StaticResource GroupItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>
            <StackPanel x:Name="SecAlbums">
              <TextBlock Text="ALBUMS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,16,0,6"/>
              <ListBox x:Name="SrAlbums" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GroupRow}"
                       ItemContainerStyle="{StaticResource GroupItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>
            <StackPanel x:Name="SecPlaylists">
              <TextBlock Text="PLAYLISTS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,16,0,6"/>
              <ListBox x:Name="SrPlaylists" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GroupRow}"
                       ItemContainerStyle="{StaticResource GroupItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"/>
            </StackPanel>
            <TextBlock x:Name="SearchEmpty" FontSize="15" Foreground="{DynamicResource Muted}" Margin="2,30,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>

        <!-- queue / up next -->
        <Grid x:Name="PageQueue" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

          <Grid Margin="30,24,30,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Up Next" FontSize="30" FontWeight="SemiBold"/>
              <TextBlock x:Name="QueueSub" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,3,0,0"/>
            </StackPanel>
            <Button x:Name="BtnClearQueue" Grid.Column="1" Style="{StaticResource TGhost}" Content="Clear"/>
          </Grid>

          <Border x:Name="QueueNow" Grid.Row="1" Margin="30,0,30,10" Padding="12,10" Background="{DynamicResource Surface2}"
                  BorderBrush="{DynamicResource Border}" BorderThickness="{DynamicResource BorderThin}" CornerRadius="{DynamicResource RadiusMd}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="QueueNowArt" Width="46" Height="46" CornerRadius="{DynamicResource RadiusSm}" Background="{DynamicResource Surface}"
                      HorizontalAlignment="Left"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="NOW PLAYING" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                <TextBlock x:Name="QueueNowTitle" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                <TextBlock x:Name="QueueNowArtist" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="2" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}"
                         VerticalAlignment="Center" Margin="12,0"/>
            </Grid>
          </Border>

          <Grid Grid.Row="2" Margin="18,0,14,8">
            <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" AllowDrop="True"
                     ItemTemplate="{StaticResource QueueRow}" ItemContainerStyle="{StaticResource GroupItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Single">
              <ListBox.ContextMenu><ContextMenu x:Name="QueueMenu"/></ListBox.ContextMenu>
            </ListBox>
            <TextBlock x:Name="QueueEmpty" FontSize="15" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380" Visibility="Collapsed"/>
          </Grid>
        </Grid>

        <!-- lyrics -->
        <Grid x:Name="PageLyrics" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Margin="30,24,30,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Lyrics" FontSize="30" FontWeight="SemiBold"/>
              <TextBlock x:Name="LyricsSub" FontSize="12.5" Foreground="{DynamicResource Muted}" Margin="2,3,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="BtnLyricsOnline" Style="{StaticResource TGhost}" Content="Find online" Margin="0,0,8,0"/>
              <Button x:Name="BtnLyricsImport" Style="{StaticResource TGhost}" Content="Import .lrc / .txt" Margin="0,0,8,0"/>
              <Button x:Name="BtnLyricsRemove" Style="{StaticResource TGhost}" Content="Remove mine"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="1">
            <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,6,8">
              <StackPanel x:Name="LyricsHost" Margin="30,10,30,60"/>
            </ScrollViewer>
            <TextBlock x:Name="LyricsEmpty" FontSize="15" Foreground="{DynamicResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="Collapsed"/>
          </Grid>
        </Grid>

        <!-- statistics -->
        <ScrollViewer x:Name="PageStats" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="StatsHost" Margin="30,24,30,26"/>
        </ScrollViewer>


        <!-- artist profile: the portrait is the centre of the page, the name sits behind it -->
        <Grid x:Name="PageArtist" Visibility="Collapsed" ClipToBounds="True">
          <Grid x:Name="HeroStack" VerticalAlignment="Top" IsHitTestVisible="False">
            <Viewbox x:Name="NameBox" Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="40,18,40,0" MaxHeight="190">
              <TextBlock x:Name="ArtistName" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Black" Foreground="{DynamicResource Fg}" Opacity="0.94"/>
            </Viewbox>
            <Grid x:Name="ArtistImage" Opacity="0" Panel.ZIndex="1">
              <Border x:Name="HeroA" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0"/>
              <Border x:Name="HeroB" HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0"/>
            </Grid>
            <TextBlock x:Name="ArtistMonogram" FontSize="260" FontWeight="Black" Opacity="0.13" Foreground="{DynamicResource Accent}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,120,0,0"/>
            <Rectangle x:Name="HeroFade" Height="180" VerticalAlignment="Bottom" Panel.ZIndex="2">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{DynamicResource BgColor0}" Offset="0"/>
                  <GradientStop Color="{DynamicResource BgColor}" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
          </Grid>

          <!-- left: actions + vertical navigation -->
          <StackPanel x:Name="LeftPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="30,0,0,34" Width="236" Panel.ZIndex="5">
            <Button x:Name="BtnArtistBack" Style="{StaticResource TText}" Content="‹   Back" HorizontalAlignment="Left" Height="30" Margin="0,0,0,12" Visibility="Collapsed"/>
            <TextBlock x:Name="ArtistMeta" FontSize="12.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,0,0,12"/>
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="BtnArtPlay" Style="{StaticResource TPrimary}" Content="▶   Play" Margin="0,0,8,8"/>
              <Button x:Name="BtnArtShuffle" Style="{StaticResource TGhost}" Content="⤮" ToolTip="Shuffle" Margin="0,0,8,8" Padding="14,0"/>
              <Button x:Name="BtnArtSort" Style="{StaticResource TGhost}" Content="⇅" ToolTip="Sort By" Margin="0,0,8,8" Padding="14,0"/>
              <Button x:Name="BtnArtFav" Style="{StaticResource TGhost}" Content="♡" ToolTip="Favorite" Margin="0,0,8,8" Padding="14,0"/>
              <Button x:Name="BtnArtMore" Style="{StaticResource TGhost}" Content="⋯" ToolTip="More options" Margin="0,0,8,8" Padding="14,0"/>
            </WrapPanel>
            <TextBlock x:Name="ArtistStatus" FontSize="11.5" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,0,0,4"/>
            <Button x:Name="BtnArtRetry" Style="{StaticResource TGhost}" Content="Retry" HorizontalAlignment="Left" Height="30" Margin="0,2,0,6" Visibility="Collapsed"/>
            <Border Height="1" Background="{DynamicResource Border}" Margin="0,10,0,10"/>
            <StackPanel x:Name="ArtistNav">
              <RadioButton x:Name="NavAbout" Style="{StaticResource VNav}" GroupName="ArtistNav" Content="ABOUT"/>
              <RadioButton x:Name="NavOverview" Style="{StaticResource VNav}" GroupName="ArtistNav" Content="OVERVIEW" IsChecked="True"/>
              <RadioButton x:Name="NavRelated" Style="{StaticResource VNav}" GroupName="ArtistNav" Content="RELATED ARTISTS"/>
            </StackPanel>
          </StackPanel>

          <!-- right: the content of the selected section -->
          <ScrollViewer x:Name="ContentScroll" HorizontalAlignment="Right" VerticalScrollBarVisibility="Auto" Panel.ZIndex="4" Width="540" Margin="0,170,24,12">
            <ScrollViewer.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{DynamicResource BgColor0}" Offset="0"/>
                <GradientStop Color="{DynamicResource BgColor85}" Offset="0.22"/>
                <GradientStop Color="{DynamicResource BgColor85}" Offset="1"/>
              </LinearGradientBrush>
            </ScrollViewer.Background>
            <Grid Margin="26,6,10,24">
              <!-- OVERVIEW -->
              <StackPanel x:Name="PanelOverview">
                <TextBlock Text="POPULAR TRACKS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,0,0,8"/>
                <ListBox x:Name="PopList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource PopularRow}"
                         ItemContainerStyle="{StaticResource PopularItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                  <ListBox.ContextMenu><ContextMenu x:Name="PopMenu"/></ListBox.ContextMenu>
                </ListBox>
                <StackPanel x:Name="PopSkeleton"/>
                <Button x:Name="BtnPopMore" Style="{StaticResource TGhost}" Content="Show more" HorizontalAlignment="Left" Margin="0,10,0,0" Height="32"/>
                <TextBlock x:Name="PopState" FontSize="13" Foreground="{DynamicResource Muted}" Margin="2,8,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="YOU MIGHT ALSO LIKE" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,30,0,2"/>
                <TextBlock x:Name="RecSub" FontSize="12" Foreground="{DynamicResource Muted}" Margin="2,0,0,8" TextWrapping="Wrap"/>
                <ListBox x:Name="RecList" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource PopularRow}"
                         ItemContainerStyle="{StaticResource PopularItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
                  <ListBox.ContextMenu><ContextMenu x:Name="RecMenu"/></ListBox.ContextMenu>
                </ListBox>
                <StackPanel x:Name="RecSkeleton"/>
                <TextBlock x:Name="RecState" FontSize="13" Foreground="{DynamicResource Muted}" Margin="2,6,0,0" TextWrapping="Wrap"/>

                <TextBlock x:Name="ReleaseTitle" Text="LATEST RELEASES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,30,0,8"/>
                <ItemsControl x:Name="ReleaseItems" ItemTemplate="{StaticResource ReleaseCard}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="ReleaseState" FontSize="13" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" TextWrapping="Wrap"/>
              </StackPanel>

              <!-- ABOUT -->
              <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                <TextBlock Text="BIOGRAPHY" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,0,0,8"/>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12"/>
                <Grid>
                  <TextBlock x:Name="BioText" FontSize="14.5" LineHeight="23" TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                  <Rectangle x:Name="BioFade" Height="46" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource BgColor0}" Offset="0"/>
                        <GradientStop Color="{DynamicResource BgColor85}" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                </Grid>
                <Button x:Name="BtnReadMore" Style="{StaticResource TGhost}" Content="Read more" HorizontalAlignment="Left" Margin="0,8,0,0" Height="32" Visibility="Collapsed"/>
                <TextBlock x:Name="BioSource" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,10,0,0"/>
                <TextBlock x:Name="BioMissing" FontSize="14" Foreground="{DynamicResource Muted}" Margin="2,0,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="DETAILS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,30,0,8"/>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
                <TextBlock x:Name="FactsText" FontSize="13.5" Foreground="{DynamicResource Fg}" LineHeight="24" TextWrapping="Wrap"/>

                <TextBlock Text="GENRES" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,30,0,8"/>
                <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="TagsPanel"/>
                <TextBlock x:Name="TagsMissing" FontSize="13" Foreground="{DynamicResource Muted}" Margin="2,0,0,0"/>
              </StackPanel>

              <!-- RELATED ARTISTS -->
              <StackPanel x:Name="PanelRelated" Visibility="Collapsed">
                <TextBlock Text="RELATED ARTISTS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="2,0,0,10"/>
                <StackPanel x:Name="RelSkeleton"/>
                <ItemsControl x:Name="RelatedItems" ItemTemplate="{StaticResource ArtistCard}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="RelatedEmpty" FontSize="14" Foreground="{DynamicResource Muted}" Margin="2,4,0,0" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>

        <!-- settings (an internal page, same shell) -->
        <Grid x:Name="PageSettings" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="214"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,26,0,0">
              <TextBlock Text="SETTINGS" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="26,0,0,10"/>
              <ListBox x:Name="SetNav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItemStyle}" FontSize="13.5"/>
            </StackPanel>
          </Border>
          <ScrollViewer x:Name="SetScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SetHost" Margin="38,30,38,34" MaxWidth="780" HorizontalAlignment="Left"/>
          </ScrollViewer>
        </Grid>

        <!-- toasts -->
        <StackPanel x:Name="ToastHost" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" IsHitTestVisible="False"/>
      </Grid>
    </Grid>

    <!-- ================= mini player (visible while browsing) ================= -->
    <Border x:Name="MiniHost" Grid.Row="2" Height="0" ClipToBounds="True" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
      <Grid x:Name="Mini" Height="80" VerticalAlignment="Top" Margin="16,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="MiniInfo" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
          <Border x:Name="MiniArt" Width="56" Height="56" Cursor="Hand" ToolTip="Open artist profile" CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource Surface2}">
            <TextBlock x:Name="MiniNote" Text="♪" FontSize="22" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="212">
            <TextBlock x:Name="MiniTitle" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="MiniArtist" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="640" Margin="12,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="MShuffle" Style="{StaticResource TIcon}" Content="&#xE8B1;" Width="34" Height="34" FontSize="14"/>
            <Button x:Name="MPrev" Style="{StaticResource TIcon}" Content="&#xE892;"/>
            <Button x:Name="MPlay" Style="{StaticResource TPlay}" Content="&#xE768;"/>
            <Button x:Name="MNext" Style="{StaticResource TIcon}" Content="&#xE893;"/>
            <Button x:Name="MRepeat" Style="{StaticResource TIcon}" Content="&#xE8EE;" Width="34" Height="34" FontSize="14"/>
          </StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="MTimeCur" Text="0:00" FontSize="11.5" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
            <local:SeekBar x:Name="MSeek" Grid.Column="1"/>
            <TextBlock x:Name="MTimeTot" Grid.Column="2" Text="0:00" FontSize="11.5" Foreground="{DynamicResource Muted}" TextAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="MFav" Style="{StaticResource TIcon}" Content="&#xE006;" Width="34" Height="34" FontSize="15" ToolTip="Favorite"/>
          <TextBlock Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center" Margin="8,0,8,0"/>
          <local:SeekBar x:Name="MVol" Width="90" VerticalAlignment="Center"/>
          <Button x:Name="MExpand" Style="{StaticResource TIcon}" Content="&#xE740;" Width="34" Height="34" FontSize="14"
                  Margin="8,0,0,0" ToolTip="Now playing - open the Gramophone"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ================= metadata editor (in-app dialog) ================= -->
    <Grid x:Name="MetaOverlay" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" Background="#B0000000" Panel.ZIndex="60">
      <Border x:Name="MetaCard" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22,26,20"
              Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="{DynamicResource BorderThin}"
              CornerRadius="{DynamicResource RadiusLg}" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="MetaScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="EDIT TRACK METADATA" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
            <TextBlock x:Name="MetaFile" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,4,0,14" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
              <TextBlock Text="Title" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/>
              <TextBox x:Name="MetaTitle" Style="{StaticResource FieldBox}"/>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Artist" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaArtist" Style="{StaticResource FieldBox}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Album" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaAlbum" Style="{StaticResource FieldBox}"/></StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Album Artist" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaAlbumArtist" Style="{StaticResource FieldBox}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Genre" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaGenre" Style="{StaticResource FieldBox}"/></StackPanel>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Track Number" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaTrackNo" Style="{StaticResource FieldBox}"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Disc Number" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaDisc" Style="{StaticResource FieldBox}"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Text="Year" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,0,0,4"/><TextBox x:Name="MetaYear" Style="{StaticResource FieldBox}"/></StackPanel>
              </Grid>
              <TextBlock Text="Cover" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,16,0,6"/>
              <StackPanel Orientation="Horizontal">
                <Grid Width="76" Height="76">
                  <Border CornerRadius="{DynamicResource RadiusMd}" Background="{DynamicResource Surface2}">
                    <TextBlock Text="♪" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="MetaCoverArt" CornerRadius="{DynamicResource RadiusMd}"/>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnMetaCover" Style="{StaticResource TGhost}" Content="Change cover…" Height="32" Margin="0,0,8,0"/>
                    <Button x:Name="BtnMetaCoverClear" Style="{StaticResource TText}" Content="Remove" Height="32"/>
                  </StackPanel>
                  <TextBlock x:Name="MetaCoverNote" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="2,8,0,0"/>
                </StackPanel>
              </StackPanel>
              <TextBlock x:Name="MetaError" FontSize="12.5" Foreground="{DynamicResource Highlight}" Margin="2,14,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnMetaCancel" Style="{StaticResource TGhost}" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="BtnMetaSave" Style="{StaticResource TPrimary}" Content="Save"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
